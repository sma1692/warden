{
  "name": "@warden/orchestrator",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "description": "Warden Control Plane, Multi-Model Orchestrator, Watchdogs & WebSocket Server",
  "scripts": {
    "dev": "WARDEN_HTTPS=true tsx watch --include \"src/**/*\" src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "WARDEN_SOURCE=md tsx --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@warden/db": "*",
    "@warden/sandbox": "*",
    "chrono-node": "^2.10.3",
    "cron-parser": "^5.10.2",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
