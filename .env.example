# ============================================================================
# DYNAMO COMMANDO — Environment Configuration (.env)
# ============================================================================
# Fill in your keys in Section A below!
# ============================================================================

# ----------------------------------------------------------------------------
# A. YOUR CORE KEYS (Fill these in!)
# ----------------------------------------------------------------------------

# 1. Gemini / Google AI Studio API Key (Primary Brain + Multimodal + Embeddings)
GEMINI_API_KEY=""

# 2. Anthropic Claude API Key (Optional C-Suite / Hybrid Brain)
ANTHROPIC_API_KEY=""

# 3. Telegram Bot Push Pager (1-Way Alerts & Standup Gate Deep-Links)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CEO_CHAT_ID=""

# 4. PostgreSQL 16 + pgvector Connection URL
#    (Will be populated when we spawn the DB with @infra_head / @infra_jr,
#     or use local Docker via `npm run db:up` with the default URL below)
DATABASE_URL="postgresql://commando:commando_secret@localhost:5432/dynamocommando"


# ----------------------------------------------------------------------------
# B. OPTIONAL CLOUD / MULTI-PROVIDER KEYS & DEFAULTS
# ----------------------------------------------------------------------------

# Google Cloud Vertex AI (Optional if using gcloud ADC instead of GEMINI_API_KEY)
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
COMMANDO_PRO_MODEL="gemini-2.5-pro"
COMMANDO_DEFAULT_MODEL="gemini-2.5-flash"
COMMANDO_EMBEDDING_MODEL="text-embedding-005"

# Additional Model Providers (Optional — OpenAI, xAI / Grok, Meta Muse, Ollama, HuggingFace/vLLM)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"                    # Tier 1 Pro: gpt-4o, o1, o3-mini | Tier 2 Shard: gpt-4o-mini
XAI_API_KEY=""                          # xAI Grok API Key
GROK_MODEL="grok-2"                     # Tier 1 Pro: grok-2, grok-beta | Tier 2 Shard: grok-2-mini
META_MUSE_API_KEY=""                    # Meta Muse API Key
META_MUSE_MODEL="muse-pro"              # Tier 1 Pro: muse-pro, muse-wonder-1.0 | Tier 2 Shard: muse-light, muse-spark-1.3
OLLAMA_BASE_URL="http://localhost:11434"
HF_VLLM_BASE_URL="http://localhost:8000/v1"
HF_API_KEY=""

# Plan → Apply Two-Stage Execution (Tier 1 Architect -> Tier 2 Fast/Local File Applier)
WARDEN_EXECUTION_MODE="case_2b"
WARDEN_L2_MODEL_PROVIDER="gemini-flash" # gemini-flash | local-ollama | haiku | gpt-4o-mini | grok-2-mini | muse-light
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="qwen2.5-coder:14b"

# Control Plane & Web Dashboard Ports
PORT=4000
ORCHESTRATOR_PORT=4000
VITE_API_URL="http://localhost:4000"
VITE_WS_URL="ws://localhost:4000/ws"
PUBLIC_APP_URL="http://localhost:5173"
PREVIEW_BASE_DOMAIN="preview.example.com"

# GCS Bucket for Multimodal Chat Attachments & QA Screenshots
GCS_MEDIA_BUCKET=""

# Docker Ephemeral Sandbox Pool
DOCKER_SOCKET_PATH="/var/run/docker.sock"
SANDBOX_BASE_IMAGE="commando-workspace:latest"
SANDBOX_PREVIEW_PORT_START=15000

# Daily Standup & Watchdog Schedules
STANDUP_TIME_IST="12:00"
IDLE_WATCHDOG_COOLDOWN_MS=14400000
MAX_RUN_DURATION_MS=86400000
MAX_TOKENS_PER_RUN=1000000

# ----------------------------------------------------------------------------
# C. SOURCE OF TRUTH, REMINDERS & WHATSAPP
# ----------------------------------------------------------------------------

# md (default) = Markdown files hydrate + receive writes; db = PostgreSQL is the source of truth
# (or just run `npm run dev:db` / `npm run dev:md`)
COMMANDO_SOURCE=md

# Gemini API model overrides (free-tier keys have no pro quota)
COMMANDO_STUDIO_PRO_MODEL=
COMMANDO_STUDIO_FLASH_MODEL=

# Reminders: timezone, default channels (whatsapp,telegram,macos,apple_reminders), poll interval
REMINDER_TZ=Asia/Kolkata
REMINDER_DEFAULT_CHANNELS=
REMINDER_POLL_MS=30000

# WhatsApp Cloud API bridge (see docs/whatsapp-setup.md); webhook: <tunnel>/webhook/whatsapp
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CEO_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US
# WhatsApp sign-in, see docs/whatsapp-setup.md sections 10 (click-to-chat QR) and 11 (6-digit code fallback)
WHATSAPP_BUSINESS_NUMBER=         # number users message to sign in (digits, country code first); empty = looked up via the Graph API
WARDEN_APP_URL=                   # optional login page link included in WhatsApp replies
WHATSAPP_OTP_TEMPLATE=            # approved AUTHENTICATION template; without it codes reach only numbers inside the 24h window
WHATSAPP_OTP_TEMPLATE_LANG=       # defaults to WHATSAPP_TEMPLATE_LANG
WHATSAPP_LOGIN_NUMBERS=           # optional allowlist, comma-separated; empty = any number can sign up
AUTH_JWT_SECRET=                  # HS256 signing secret; empty = generated once into .state/auth-secret
AUTH_JWT_TTL_DAYS=30
# AUTH_DEV_OTP=246810             # LOCAL TESTING ONLY: fixed code, nothing sent; ignored when NODE_ENV=production
# WHATSAPP_AUTO_REPLY=Hi, this is Warden.   # optional: fixed reply to every inbound message, skips agents
