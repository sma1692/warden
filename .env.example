# ============================================================================
# WARDEN — Environment Configuration (.env) — Meta-Only
# ============================================================================
# Fill in your Meta Muse key in Section A below!
# ============================================================================

# ----------------------------------------------------------------------------
# A. YOUR CORE KEYS (Fill these in!)
# ----------------------------------------------------------------------------

# 1. Meta Muse API Key (Primary Brain: Wonder / Spark / Image / Voice + Embeddings)
#    Get one at https://dev.meta.ai (Start building -> API key).
META_MUSE_API_KEY=""

# 2. Meta Muse Backup API Key (Failover Pool — optional second key)
META_MUSE_BACKUP_API_KEY=""

# 3. Meta Model API Base URL (override only for proxies / staging)
META_MUSE_BASE_URL="https://api.meta.ai/v1"

# 4. Telegram Bot Push Pager (1-Way Alerts & Standup Gate Deep-Links)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CEO_CHAT_ID=""

# 5. PostgreSQL 16 + pgvector Connection URL
#    (Will be populated when we spawn the DB with @infra_head / @infra_jr,
#     or use local Docker via `npm run db:up` with the default URL below)
DATABASE_URL="postgresql://warden:warden_secret@localhost:5432/warden"


# ----------------------------------------------------------------------------
# B. MODEL DEFAULTS & LOCAL META OPEN-WEIGHTS RUNTIMES
# ----------------------------------------------------------------------------

# Tier 1 Architect (L0/L1 planning & reasoning) and Tier 2 Applier (L2 coding loops)
WARDEN_PRO_MODEL="muse-wonder-1.0"
WARDEN_DEFAULT_MODEL="muse-spark-1.3"
WARDEN_EMBEDDING_MODEL="muse-embed-1.0"

# Local Meta open-weights runtimes (Ollama + vLLM serving Llama / Muse Glimmer)
OLLAMA_BASE_URL="http://localhost:11434"
HF_VLLM_BASE_URL="http://localhost:8000/v1"
HF_API_KEY=""

# Plan → Apply Two-Stage Execution (Tier 1 Architect -> Tier 2 Fast/Local File Applier)
WARDEN_EXECUTION_MODE="case_2b"
WARDEN_L2_MODEL_PROVIDER="muse-spark" # muse-spark | muse-light | muse-flash | local-ollama | local
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama-3.3-70b"

# GitHub OAuth — cloud-safe code edits (agents branch + PR on git, no local FS).
# Create a free OAuth App at github.com/settings/developers, set the callback to
# http://localhost:4000/api/github/callback (prod: https://<api>/api/github/callback).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URL=""

# Cloud multi-user mode (WARDEN_CLOUD=true forces Postgres, no MD fallback)
WARDEN_CLOUD="false"

# Demo provisioning: server-side credential + target repo (one branch/PR per demo user)
GITHUB_DEMO_TOKEN=""
DEMO_REPO_FULL_NAME=""
DEMO_BASE_REF="demo-base"
DEMO_PR_BASE="main"

# Demo game folders + Cloudflare per-user deploy (Tic-Tac-Toe Arena scaffold)
DEMO_WORKSPACE_ROOT="user-demos"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_BASE_DOMAIN=""
CLOUDFLARE_PAGES_PREFIX="warden"
CLOUDFLARE_PROD_BRANCH="main"

# Per-operator token budgets (0 = unlimited)
DEMO_TOKEN_CAP="1000000"
FULL_TOKEN_CAP="10000000"

# Control Plane & Web Dashboard Ports
PORT=4000
ORCHESTRATOR_PORT=4000
# Local dev LAN HTTPS for phone testing (dev scripts set WARDEN_HTTPS=true).
# Self-signed cert with localhost + LAN SANs is auto-generated into .state/certs/.
# WARDEN_HTTPS="true"
# Dev-only Vite proxy target override (defaults follow WARDEN_HTTPS).
# WARDEN_API_URL="https://localhost:4000"
VITE_API_URL="http://localhost:4000"
VITE_WS_URL="ws://localhost:4000/ws"
PUBLIC_APP_URL="http://localhost:5173"
PREVIEW_BASE_DOMAIN="preview.example.com"

# Local Media Bucket for Multimodal Chat Attachments & QA Screenshots
MEDIA_BUCKET=""

# Docker Ephemeral Sandbox Pool
DOCKER_SOCKET_PATH="/var/run/docker.sock"
SANDBOX_BASE_IMAGE="warden-workspace:latest"
SANDBOX_PREVIEW_PORT_START=15000

# Daily Standup & Watchdog Schedules
STANDUP_TIME_IST="12:00"
IDLE_WATCHDOG_COOLDOWN_MS=14400000
MAX_RUN_DURATION_MS=86400000
MAX_TOKENS_PER_RUN=1000000

# ----------------------------------------------------------------------------
# C. SOURCE OF TRUTH, REMINDERS & WHATSAPP
# ----------------------------------------------------------------------------

# md (default) = Markdown files hydrate + receive writes; db = PostgreSQL is the source of truth
# (or just run `npm run dev:db` / `npm run dev:md`)
WARDEN_SOURCE=md

# Global routing profile: META_MUSE_HACKATHON (default) | LOCAL_ZERO_COST | CUSTOM_HYBRID
WARDEN_ROUTING_PROFILE="META_MUSE_HACKATHON"

# Reminders: timezone, default channels (whatsapp,telegram,macos,apple_reminders), poll interval
REMINDER_TZ=Asia/Kolkata
REMINDER_DEFAULT_CHANNELS=
REMINDER_POLL_MS=30000

# WhatsApp Cloud API bridge (see docs/whatsapp-setup.md); webhook: <tunnel>/webhook/whatsapp
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CEO_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US
# WhatsApp sign-in, see docs/whatsapp-setup.md sections 10 (click-to-chat QR) and 11 (6-digit code fallback)
WHATSAPP_BUSINESS_NUMBER=         # number users message to sign in (digits, country code first); empty = looked up via the Graph API
WARDEN_APP_URL=                   # optional login page link included in WhatsApp replies
WHATSAPP_OTP_TEMPLATE=            # approved AUTHENTICATION template; without it codes reach only numbers inside the 24h window
WHATSAPP_OTP_TEMPLATE_LANG=       # defaults to WHATSAPP_TEMPLATE_LANG
WHATSAPP_LOGIN_NUMBERS=           # optional allowlist, comma-separated; empty = any number can sign up
WHATSAPP_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
AUTH_JWT_SECRET=                  # HS256 signing secret; empty = generated once into .state/auth-secret
AUTH_JWT_TTL_DAYS=30
# AUTH_DEV_OTP=246810             # LOCAL TESTING ONLY: fixed code, nothing sent; ignored when NODE_ENV=production

# Email OTP sign-in over SMTP (GSuite or Outlook app password). Unset = dev-log fallback locally, 503 in production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_SECURE="false"
# WHATSAPP_AUTO_REPLY=Hi, this is Warden.   # optional: fixed reply to every inbound message, skips agents
