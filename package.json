{
  "name": "warden",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Warden: Open-Source Autonomous Multi-Agent Command Center & Chief of Staff Framework",
  "workspaces": [
    "packages/db",
    "packages/sandbox",
    "packages/orchestrator",
    "packages/web",
    "packages/client"
  ],
  "scripts": {
    "dev": "WARDEN_SOURCE=db npm run dev --workspaces --if-present",
    "dev:db": "WARDEN_SOURCE=db npm run dev",
    "dev:md": "WARDEN_SOURCE=md npm run dev --workspaces --if-present",
    "dev:api": "WARDEN_SOURCE=db npm --workspace=@warden/orchestrator run dev",
    "dev:api:db": "WARDEN_SOURCE=db npm run dev:api",
    "dev:api:md": "WARDEN_SOURCE=md npm --workspace=@warden/orchestrator run dev",
    "dev:web": "npm --workspace=@warden/web run dev",
    "dev:ui": "npm --workspace=@warden/web run dev:ui",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs prod",
    "build:stag": "node scripts/build.mjs stag",
    "build:local": "node scripts/build.mjs local",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace=@warden/db run migrate",
    "db:ingest": "npm --workspace=@warden/db run ingest",
    "db:sync": "node scripts/sync-md-db.ts",
    "sync": "node scripts/sync-md-db.ts",
    "sandbox:build-image": "docker build -f infra/docker/Dockerfile.workspace -t warden-workspace:latest .",
    "standup": "node scripts/warden-muse.mjs standup",
    "standup:auto": "node scripts/warden-muse.mjs standup --auto-execute",
    "daemon": "node scripts/warden-muse.mjs daemon",
    "daemon:8h": "node scripts/warden-muse.mjs daemon --interval=8h",
    "chat": "node scripts/warden-muse.mjs chat",
    "ask": "node scripts/warden-muse.mjs ask",
    "build:kit": "node scripts/build-kit.mjs",
    "onboard": "node scripts/onboard.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
